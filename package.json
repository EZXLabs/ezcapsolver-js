{
  "name": "ezcapsolver-js",
  "version": "0.1.0",
  "description": "JavaScript/TypeScript SDK for EzCaptchaSolver.",
  "keywords": [
    "captcha",
    "recaptcha",
    "funcaptcha",
    "hcaptcha",
    "turnstile",
    "cloudflare",
    "akamai",
    "datadome",
    "perimeterx",
    "incapsula",
    "anti-bot"
  ],
  "homepage": "https://ezxlabs.com",
  "bugs": "https://github.com/EZXLabs/ezcapsolver-js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EZXLabs/ezcapsolver-js.git"
  },
  "license": "Apache-2.0",
  "author": "EZXLabs <admin@ezxlabs.com>",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts --platform neutral --target node22 --sourcemap --clean",
    "check": "biome check .",
    "docs": "typedoc",
    "format": "biome format --write .",
    "lint": "biome check --write .",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:package": "publint && attw --pack ."
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
